   "source": [
    "def reverse_complement(seq):\n",
    "    seq = seq.upper()\n",
    "    pairs = { \"A\" : \"T\" , \"T\" : \"A\" , \"G\" : \"C\" , \"C\" : \"G\" , \"N\" : \"N\" }\n",
    "    rc = \"\"\n",
    "    for base in seq[::-1]:\n",
    "        rc = rc + pairs[base]\n",
    "    return rc"
   ]
  },
  {
